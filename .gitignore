# Node.js dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# SQLite databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Application logs
logs/
*.log
npm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor-specific files
.vscode/
.idea/

# Test coverage
coverage/

# Build output
dist/
build/
